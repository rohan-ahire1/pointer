{
  "permissions": {
    "allow": [
      "Bash(node .factory/gates.mjs:*)",
      "Bash(node .factory/verify.mjs:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin master:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.factory/guard.mjs\""
          }
        ]
      }
    ]
  }
}
